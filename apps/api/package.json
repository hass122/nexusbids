  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npx tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npx tsc -p tsconfig.json",
    "test": "npx tsx src/test/business-logic.test.ts && npx tsx src/test/admin-logic.test.ts && npx tsx src/test/payment-lifecycle.test.ts && npx tsx src/test/ai-recommendation-fraud.test.ts && npx tsx src/test/protection-shipping-reputation.test.ts && npx tsx src/test/full-complete-marketplace-flow.test.ts",
    "migrate": "npx tsx src/scripts/migrate.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@nexusbids/shared": "file:../../packages/shared",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "multer-storage-cloudinary": "^4.0.0",
    "mysql2": "^3.9.7",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.1.1",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "tsx": "^4.9.0",
    "typescript": "^5.4.5"
  }
}
