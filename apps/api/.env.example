# ============================================================
# NEXUSBIDS API ENVIRONMENT CONFIGURATION (SECURE)
# ============================================================

PORT=your_port_here
NODE_ENV=your_node_env_here

# MySQL Database
DB_HOST=your_db_host_here
DB_PORT=your_db_port_here
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here
DB_CONNECTION_LIMIT=your_db_connection_limit_here

# Cryptographically Generated JWT Secrets (Min 32 characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# KYC Encryption Key (AES-256-CBC 32 bytes)
KYC_ENCRYPTION_KEY=your_kyc_encryption_key_here

# Cron Token (Bearer token for authorized cron scheduler)
CRON_SECRET=your_cron_secret_here

# Allowed CORS Origins (Comma-separated)
CORS_ORIGIN=your_cors_origin_here

# AI Configuration
AI_FEATURES_ENABLED=true
AI_BASE_URL=your_ai_base_url_here
AI_API_KEY=your_ai_api_key_here
AI_MODEL=your_ai_model_here
AI_FALLBACK_MODEL=your_ai_fallback_model_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=your_gemini_vision_model_here

# Payment Gateway Configuration (demo / sandbox / production)
PAYMENT_MODE=your_payment_mode_here
JAZZCASH_HMAC_SECRET=your_jazzcash_hmac_secret_here
EASYPAISA_HMAC_SECRET=your_easypaisa_hmac_secret_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=your_google_callback_url_here

# ─── Pusher Real-time Configuration ───────────────────────────
# Get from: https://dashboard.pusher.com → Your App → App Keys
PUSHER_APP_ID=your_pusher_app_id_here
PUSHER_KEY=your_pusher_key_here
PUSHER_SECRET=your_pusher_secret_here
PUSHER_CLUSTER=ap2

# ─── Cloudinary File Storage ───────────────────────────────────
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ─── Email (Gmail SMTP via Nodemailer) ────────────────────────
# Use Gmail + App Password (not real password)
# Generate App Password: Google Account → Security → 2FA → App Passwords
EMAIL_FROM=NexusBids <your_email@gmail.com>
EMAIL_USER=your_gmail_address_here
EMAIL_PASS=your_gmail_app_password_here
EMAIL_ENABLED=false
